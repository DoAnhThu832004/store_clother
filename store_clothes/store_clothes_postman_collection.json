            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cashier1\",\n  \"password\": \"password123\",\n  \"fullName\": \"Nguyễn Văn Ngân\",\n  \"email\": \"cashier1@example.com\",\n  \"phone\": \"0912345678\",\n  \"roleName\": \"ROLE_CASHIER\"\n}",
              "options": {
