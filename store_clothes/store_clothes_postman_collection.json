          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Ngân Sửa\",\n  \"email\": \"cashier1_edit@example.com\",\n  \"phone\": \"0912345679\",\n  \"status\": \"ACTIVE\",\n  \"roleName\": \"ROLE_MANAGER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "2"
              ]
            },
            "description": "Cập nhật thông tin nhân viên hoặc đổi vai trò (chỉ OWNER được gọi)."
          }
        },
        {
          "name": "Xóa mềm nhân viên (USR-05)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "2"
              ]
            },
            "description": "Xóa mềm nhân viên (chỉ OWNER được gọi, không tự xóa chính mình)."
          }
        }
      ]
    },
