{
  "info": {
    "name": "Store Clothes POS API",
    "description": "Postman Collection for Store Clothes POS & Inventory Management System (Spring Boot)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication (Xác thực)",
      "item": [
        {
          "name": "Đăng nhập (Login)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"owner\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập hệ thống để nhận JWT Access Token và Refresh Token."
          }
        },
        {
          "name": "Làm mới Token (Refresh Token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh?refreshToken=YOUR_REFRESH_TOKEN_HERE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ],
              "query": [
                {
                  "key": "refreshToken",
                  "value": "YOUR_REFRESH_TOKEN_HERE"
                }
              ]
            },
            "description": "Lấy access token mới bằng refresh token."
          }
        },
        {
          "name": "Thông tin cá nhân (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Lấy thông tin tài khoản đang đăng nhập từ JWT."
          }
        },
        {
          "name": "Đổi mật khẩu (Change Password)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me/password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                "password"
              ]
            },
            "description": "Đổi mật khẩu tài khoản hiện tại."
          }
        },
        {
          "name": "Đăng ký cửa hàng mới (Tenant)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Cửa hàng Thời trang Thu Hà\",\n  \"storeCode\": \"thuha-store\",\n  \"contactEmail\": \"contact@thuha.com\",\n  \"contactPhone\": \"0912345678\",\n  \"ownerUsername\": \"admin_thuha\",\n  \"ownerPassword\": \"password123\",\n  \"ownerFullName\": \"Nguyễn Thị Thu Hà\",\n  \"ownerEmail\": \"ha.nguyen@example.com\",\n  \"ownerPhone\": \"0987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
