            "description": "Chỉ OWNER được tạo tài khoản nhân viên (ROLE_MANAGER, ROLE_CASHIER, ROLE_WAREHOUSE_STAFF)."
          }
        },
        {
          "name": "Danh sách nhân viên (USR-02)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=0&size=20&keyword=Ngân",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
